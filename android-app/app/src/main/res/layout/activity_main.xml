<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tv_system_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:padding="14dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الاتصال بكمبيوتر Windows (Client Mode)"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/et_pc_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="عنوان IP للكمبيوتر (مثال: 192.168.1.100)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:inputType="textUri"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/et_pc_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="رمز الأمان PIN (6 أرقام)"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:inputType="number"
            android:maxLength="6"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btn_connect_pc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="الاتصال والتحكم بالكمبيوتر الآن"
            android:backgroundTint="@color/primary"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="استضافة الشاشة للكمبيوتر (Host Mode)"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_host_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_start_cast"
            android:backgroundTint="@color/accent"
            android:textColor="@color/text_primary"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_accessibility_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إعدادات إمكانية الوصول (Accessibility)"
            android:backgroundTint="@color/surface"
            android:textColor="@color/text_secondary"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
