<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SmartRemoteControl.Windows</RootNamespace>
    <AssemblyName>SmartRemoteControl.Windows</AssemblyName>
    <ApplicationIcon Condition="Exists('Assets/app.ico')">Assets/app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Authors>Smart Remote Engineering Team</Authors>
    <Company>Smart Remote Control</Company>
    <Description>برنامج التحكم عن بعد المتقدم لنظام Windows - متوافق مع Android وشبكة الاتصال المحلية</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
  </ItemGroup>

</Project>
